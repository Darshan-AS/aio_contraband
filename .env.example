# TorBox API Key (also auto-discovered from ../stream-weaver/.env if present)
SECRET_TORBOX_API_KEY=

# Optional custom emblem URL for Contraband manifest.json
ADDON_LOGO_URL=

# Optional target directory override when compiling static addon files into a separate repo
ADDON_REPO_DIR=

# Optional AIOStreams install URL for refreshing TorBox Cloud Library cache after `cb add`/`cb watch`
AIOSTREAMS_INSTALL_URL=

# Optional legacy opt-in ("true"/"false") to emit account-bound meta/library/aiostreams::* files
ADDON_EMIT_LIBRARY_META=false
